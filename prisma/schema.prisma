generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Localized text fields are stored as JSON objects keyed by locale:
// { "lt": "...", "en": "...", "ru": "...", "pl": "..." }

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        Json
  description Json?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum RipeningTime {
  VERY_EARLY
  EARLY
  MEDIUM
  LATE
}

enum BerryColor {
  GREEN
  YELLOW
  PINK
  RED
  BLUE
}

enum GrapeUsage {
  TABLE
  WINE
  UNIVERSAL
}

model Product {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            Json
  description     Json
  growingInfo     Json?
  priceCents      Int
  salePriceCents  Int?
  stock           Int          @default(0)
  published       Boolean      @default(true)
  featured        Boolean      @default(false)
  category        Category     @relation(fields: [categoryId], references: [id])
  categoryId      String
  // Grape variety attributes
  ripening        RipeningTime @default(MEDIUM)
  frostResistance Int? // minimum survivable temperature in °C, e.g. -25
  berryColor      BerryColor   @default(BLUE)
  usage           GrapeUsage   @default(UNIVERSAL)
  seedless        Boolean      @default(false)
  images          ProductImage[]
  orderItems      OrderItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId])
  @@index([published, featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  MONTONIO
}

enum ShippingMethod {
  OMNIVA
  LP_EXPRESS
  COURIER
}

model Order {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  status         OrderStatus    @default(PENDING)
  locale         String         @default("lt")
  // Customer
  customerName   String
  customerEmail  String
  customerPhone  String
  // Shipping
  shippingMethod ShippingMethod
  terminalId     String? // pickup point id (Omniva / LP Express)
  terminalName   String? // human-readable pickup point label
  address        String? // courier delivery
  city           String?
  postalCode     String?
  note           String?
  // Payment
  paymentMethod  PaymentMethod  @default(STRIPE)
  paymentId      String? // e.g. Stripe checkout session id
  paidAt         DateTime?
  // Money (euro cents, captured at order time)
  subtotalCents  Int
  shippingCents  Int
  totalCents     Int
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id            String  @id @default(cuid())
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product @relation(fields: [productId], references: [id])
  productId     String
  // snapshot at purchase time
  nameSnapshot  String
  unitPriceCents Int
  quantity      Int

  @@index([orderId])
}

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
}

// Singleton (id = "main") store configuration editable from the admin panel
model StoreSettings {
  id                    String  @id @default("main")
  omnivaPriceCents      Int     @default(399)
  lpExpressPriceCents   Int     @default(349)
  courierPriceCents     Int     @default(599)
  freeShippingFromCents Int?    @default(6000)
  contactEmail          String  @default("")
  contactPhone          String  @default("")
}
