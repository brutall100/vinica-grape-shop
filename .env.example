# Copy this file to .env and fill in your own values: cp .env.example .env
# Never commit the real .env file.

# PostgreSQL connection string (local database or Neon / Supabase)
DATABASE_URL="postgresql://vinica:change_me@localhost:5432/vinica_shop"

# Public address of the shop (used for SEO, sitemap and payment redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js secret for the admin panel – generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# First admin account created by `npm run db:seed` (password is stored hashed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# Stripe payments (optional – without them orders are created as "awaiting payment")
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Resend e-mails (optional – without a key e-mails are only logged to the console)
RESEND_API_KEY=""
EMAIL_FROM="Vinica <shop@example.com>"

# Vercel Blob image storage (optional – locally images go to public/uploads)
BLOB_READ_WRITE_TOKEN=""
